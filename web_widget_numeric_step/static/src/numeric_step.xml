<template>
    <t t-name="web_widget_numeric_step">
        <div
            t-attf-class="d-flex widget_numeric_step {{this.props.additional_class or ''}}"
        >
            <div class="input-group-prepend widget_numeric_step_btn">
                <button
                    class="oi btn btn-default btn_numeric_step"
                    data-icon="remove"
                    aria-label="Minus"
                    tabindex="-1"
                    title="Minus"
                    type="button"
                    data-mode="minus"
                    t-att-disabled="this.props.readonly"
                    t-on-click="this._onStepClick"
                />
            </div>
            <input
                t-att-id="this.props.id"
                class="o_input"
                t-ref="this.numpadDecimalRef"
                t-att-placeholder="this.props.placeholder"
                t-att-type="this.props.inputType"
                inputmode="decimal"
                autocomplete="off"
                t-att-step="this.props.step"
                t-on-focusin="this.onFocusIn"
                t-on-focusout="this.onFocusOut"
                t-on-keydown="this._onKeyDown"
                t-on-wheel="this._onWheel"
            />
            <div class="input-group-append widget_numeric_step_btn">
                <button
                    class="oi btn btn-default btn_numeric_step"
                    data-icon="add"
                    aria-label="Plus"
                    tabindex="-1"
                    title="Plus"
                    type="button"
                    data-mode="plus"
                    t-att-disabled="this.props.readonly"
                    t-on-click="this._onStepClick"
                />
            </div>
        </div>
    </t>
</template>
